# ─── Backend ────────────────────────────────────────────────────────────────
# ZMIEŃ TE WARTOŚCI W PRODUKCJI!
SECRET_KEY=your-secret-key-change-me
JWT_SECRET_KEY=your-jwt-secret-change-me

# Baza danych (domyślnie SQLite)
# DATABASE_URL=sqlite:///data/app.db
# DATABASE_URL=postgresql://user:pass@localhost/mcpanel

# Ścieżka do folderów serwerów Minecraft
# SERVER_BASE_PATH=/opt/mcpanel/servers

# Maksymalna liczba backupów na serwer
MAX_BACKUP_COUNT=10

# Debug mode (false w produkcji)
FLASK_DEBUG=false
PORT=5000

# Dodatkowe originy CORS (oddzielone przecinkami)
# ALLOWED_ORIGINS=https://panel.example.com,http://192.168.1.100:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL API backendu (jeśli inny niż localhost:5000)
# REACT_APP_API_URL=http://192.168.1.100:5000
